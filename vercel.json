{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
